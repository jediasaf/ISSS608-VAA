\":2},{\"name\":\"YOUNG\",\"targets\":3},{\"name\":\"ACTIVE\",\"targets\":4},{\"name\":\"OLD\",\"targets\":5},{\"name\":\"TOTAL\",\"targets\":6}],\"order\":[],\"autoWidth\":false,\"orderClasses\":false}},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\n# 1. Static Ternary Plot with ggtern\n\n## 1.1 Basic Ternary Plot\n\n\n::: {.cell}\n\n```{.r .cell-code}\nggtern(data = agpop_mutated, aes(x = YOUNG, y = ACTIVE, z = OLD)) +\n  geom_point()\n```\n\n::: {.cell-output-display}\n![](hands_on_exercise_5b_files/figure-html/unnamed-chunk-4-1.png){width=672}\n:::\n:::\n\n\n## 1.2 With the `theme_rgbw()` Theme\n\n\n::: {.cell}\n\n```{.r .cell-code}\nggtern(data = agpop_mutated, aes(x = YOUNG, y = ACTIVE, z = OLD)) +\n  geom_point() +\n  labs(title = \"Population structure of Singapore subzones, 2018\") +\n  theme_rgbw()\n```\n\n::: {.cell-output-display}\n![](hands_on_exercise_5b_files/figure-html/unnamed-chunk-5-1.png){width=672}\n:::\n:::\n\n\n# 2. Interactive Ternary Plot with plotly\n\n\n::: {.cell}\n\n```{.r .cell-code}\n# reusable axis-label formatter\naxis <- function(txt) {\n  list(\n    title = txt, tickformat = \".0%\", tickfont = list(size = 10)\n  )\n}\n\nternaryAxes <- list(\n  aaxis = axis(\"Young\"),\n  baxis = axis(\"Active\"),\n  caxis = axis(\"Old\")\n)\n\nplot_ly(\n  agpop_mutated,\n  a = ~YOUNG,\n  b = ~ACTIVE,\n  c = ~OLD,\n  color = I(\"#1f77b4\"),\n  type = \"scatterternary\",\n  text = ~paste0(\"Subzone: \", SZ)\n) %>%\n  layout(\n    title = \"Population structure, 2018\",\n    ternary = ternaryAxes\n  )\n```\n\n::: {.cell-output .cell-output-stderr}\n\n```\nNo scatterternary mode specifed:\n  Setting the mode to markers\n  Read more about this attribute -> https://plotly.com/r/reference/#scatter-mode\n```\n\n\n:::\n\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"plotly html-widget html-fill-item\" id=\"htmlwidget-91446843a5212479b39c\" style=\"width:100%;height:464px;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidg